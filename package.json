{
	"name": "sveltekit-learning-lab",
	"private": true,
	"version": "0.2.0",
	"description": "A source-first SvelteKit learning project with PostgreSQL, sessions, authorization and Docker deployment",
	"license": "MIT",
	"homepage": "https://github.com/hirot192/sveltekit-learning-lab#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hirot192/sveltekit-learning-lab.git"
	},
	"bugs": {
		"url": "https://github.com/hirot192/sveltekit-learning-lab/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"check:content": "node --import tsx scripts/check-content.ts",
		"format": "prettier --write .",
		"db:up": "docker compose up -d db",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"docker:build": "docker build --tag sveltekit-learning-lab:local .",
		"deploy": "scripts/deploy.sh",
		"backup": "scripts/backup.sh",
		"test:unit": "vitest",
		"test:db": "RUN_DB_TESTS=1 vitest --run src/lib/server",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@types/pg": "^8.20.0",
		"@vitest/browser-playwright": "^4.1.8",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.9.1",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.22.0",
		"zod": "^4.4.3"
	},
	"overrides": {
		"cookie": "0.7.2",
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	}
}
