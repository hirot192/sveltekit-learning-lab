# Copy this file to .env.production and replace every change-me value.
# Keep this file on the server only; .env.production is ignored by Git.
APP_VERSION=local
APP_PORT=3000
COMPOSE_PROJECT_NAME=sveltekit-learning-lab
ORIGIN=https://learn.example.com

POSTGRES_DB=sveltekit_learning_lab
POSTGRES_USER=sveltekit
POSTGRES_PASSWORD=change-me-use-a-long-random-password

# Use the Compose service name "db", not localhost. URL-encode special password characters.
DATABASE_URL=postgresql://sveltekit:change-me-use-a-long-random-password@db:5432/sveltekit_learning_lab

SHUTDOWN_TIMEOUT=30
BODY_SIZE_LIMIT=512K
